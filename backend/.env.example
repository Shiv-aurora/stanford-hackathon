CONSTELLATION_RUNTIME=supergrid
CONSTELLATION_FEDERATION=@qxh2001/security
# Public HTTPS address forwarding to this FastAPI backend (no trailing /api).
CONSTELLATION_BRIDGE_URL=https://your-backend.example.com
# Eight original workers plus a fresh node for every replacement.
CONSTELLATION_FLOWER_NODES=9
# Stop the remote run after this many seconds, or earlier on human approval.
CONSTELLATION_CONTROL_TTL=900
