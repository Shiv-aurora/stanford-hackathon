# Copy to backend/.env (gitignored) to give workers a real model.
# Any OpenAI Responses-compatible endpoint works (OpenAI, Nebius Token Factory, ...).
# Each worker sends the model only its own task and context slice.
# Leave unset for deterministic placeholder output.
FLWR_MODEL_API_ENDPOINT=https://api.openai.com/v1/responses
FLWR_MODEL_ID=gpt-4.1-mini
FLWR_MODEL_API_KEY=
