CONSTELLATION_RUNTIME=supergrid
CONSTELLATION_FEDERATION=@qxh2001/security
# Dedicated trusted control SuperNode ID, registered in this federation.
CONSTELLATION_CONTROL_NODE_ID=
# Worker nodes only: eight originals + one replacement. Control node is extra.
CONSTELLATION_FLOWER_NODES=9
CONSTELLATION_WORKER_TIMEOUT=300
CONSTELLATION_CONTROL_TTL=900
# Optional legacy HTTPS mode: used only when CONTROL_NODE_ID is empty.
# CONSTELLATION_BRIDGE_URL=https://your-backend.example.com
# Copy to backend/.env (gitignored) to give workers a real model.
# Any OpenAI Responses-compatible endpoint works (OpenAI, Nebius Token Factory, ...).
# Each worker sends the model only its own task and context slice.
# Leave unset for deterministic placeholder output.
FLWR_MODEL_API_ENDPOINT=https://api.openai.com/v1/responses
FLWR_MODEL_ID=gpt-4.1-mini
FLWR_MODEL_API_KEY=
